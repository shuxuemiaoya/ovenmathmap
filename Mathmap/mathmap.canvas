    },
    {
      "color": "2",
      "height": 55,
      "id": "dda50596100d50f9",
      "text": "[[Mathmap/知识串联/人教A-必修第二册/第六章 平面向量及其应用/6.2 平面向量的运算/6.2.3 向量的数乘运算|向量的数乘运算]]",
      "type": "text",
      "width": 244,
      "x": -2436,
      "y": 2936
    },
    {
      "color": "2",
      "height": 50,
      "id": "50d6d93282feb424",
      "text": "[[Mathmap/知识串联/人教A-必修第二册/第六章 平面向量及其应用/6.2 平面向量的运算/6.2.2 向量的减法运算|向量的减法运算]]",
      "type": "text",
      "width": 264,
      "x": -2436,
      "y": 2817
    },
    {
      "height": 60,
      "id": "5138f99c4d1bf40a",
      "text": "力的加法",
      "type": "text",
      "width": 250,
      "x": -3464,
      "y": 2757
    },
    {
      "height": 60,
      "id": "830311d97aaa285b",
      "text": "位移",
      "type": "text",
      "width": 250,
      "x": -3464,
      "y": 2877
    },
    {
      "color": "2",
      "height": 60,
      "id": "bae0b35a997b3aca",
      "text": "[[Mathmap/知识串联/mst老唐说题-圆锥曲线-2026/上册/第02章_离心率/第三节_长度与角度下的离心率范围约束/三_向量乘积与极化恒等式的约束/三_向量乘积与极化恒等式的约束|极化恒等式]]",
      "type": "text",
      "width": 250,
      "x": -1012,
      "y": 3470
    },
    {
      "height": 60,
      "id": "da5363f9a935dfea",
      "text": "$(\\lambda a)\\cdot b = \\lambda (a\\cdot b) = a\\cdot (\\lambda b)$",
      "type": "text",
      "width": 392,
      "x": -2534,
      "y": 3894
    },
    {
      "height": 60,
      "id": "af491b66a4146985",
      "text": "$(a + b)\\cdot c = a\\cdot c + b\\cdot c.$",
      "type": "text",
      "width": 332,
      "x": -2534,
      "y": 3978
    },
    {
      "height": 60,
      "id": "ca2ff6bfcb4ff1f8",
      "text": "$(a\\cdot b)c \\neq a(b\\cdot c)$",
      "type": "text",
      "width": 232,
      "x": -2534,
      "y": 4058
    },
    {
      "height": 60,
      "id": "4e648f4927bada52",
      "text": "$a\\cdot b = b\\cdot a$",
      "type": "text",
      "width": 160,
      "x": -2534,
      "y": 3808
    },
    {
      "height": 101,
      "id": "7d1785ae1eeda521",
      "text": "零向量与任一向量的数量积为0",
      "type": "text",
      "width": 254,
      "x": -3404,
      "y": 3509
    },
    {
      "color": "2",
      "height": 60,
      "id": "58a78169e16ecbab",
      "text": "[[Mathmap/题型/按章节分类/人教A-必修第二册/第六章 平面向量及其应用/6.3 平面向量基本定理及坐标表示/习题6.3|习题6.3]]",
      "type": "text",
      "width": 250,
      "x": -177,
      "y": 4011
    },
    {
      "height": 60,
      "id": "918be7871a07c7d8",
      "text": "水平方向才做功",
      "type": "text",
      "width": 252,
      "x": -3464,
      "y": 3347
    },
    {
      "height": 88,
      "id": "fbac45101288f213",
      "text": "$\\cos \\theta = \\frac{\\overrightarrow{a} \\cdot \\overrightarrow{b}}{| \\overrightarrow{a} | | \\overrightarrow{b} |}$",
      "type": "text",
      "width": 185,
      "x": -2062,
      "y": 3223
    },
    {
      "height": 60,
      "id": "4732e59d1cf1bf95",
      "text": "$a \\cdot e = e \\cdot a = \\left|a\\right|\\cos \\theta .$",
      "type": "text",
      "width": 290,
      "x": -2062,
      "y": 3330
    },
    {
      "height": 60,
      "id": "57f517877ed9ddd3",
      "text": "$a \\perp b \\Leftrightarrow a \\cdot b = 0$",
      "type": "text",
      "width": 250,
      "x": -2062,
      "y": 3410
    },
    {
      "height": 101,
      "id": "894ff18a5185212b",
      "text": "向量夹角的范围\n$<\\vec{a} , \\vec{b}> \\in [0,\\pi]$",
      "type": "text",
      "width": 192,
      "x": -3071,
      "y": 3509
    },
    {
      "height": 60,
      "id": "9eff7bf429af19d0",
      "text": "$(a + b)\\cdot (a - b) = a^{2} - b^{2}$",
      "type": "text",
      "width": 352,
      "x": -1944,
      "y": 3991
    },
    {
      "height": 60,
      "id": "bb436528500bea8d",
      "text": "$(a + b)^{2} = a^{2} + 2a\\cdot b + b^{2}$",
      "type": "text",
      "width": 372,
      "x": -1944,
      "y": 3881
    },
    {
      "height": 60,
      "id": "a168bae658e6ff49",
      "text": "$| \\overrightarrow{a} \\cdot \\overrightarrow{b} | \\leq | \\overrightarrow{a} | | \\overrightarrow{b} |$",
      "type": "text",
      "width": 250,
      "x": -2062,
      "y": 3490
    },
    {
      "height": 60,
      "id": "91e667945c709f13",
      "text": "$a \\cdot a = \\left|a\\right|^{2}$",
      "type": "text",
      "width": 158,
      "x": -2062,
      "y": 3564
    },
    {
      "height": 50,
      "id": "cfcc443d58e2aeef",
      "text": "$\\left|a\\right|\\cos \\theta e.$",
      "type": "text",
      "width": 140,
      "x": -2524,
      "y": 3238
    },
    {
      "height": 60,
      "id": "1d7a523db65fdd62",
      "text": "$\\vec{a} \\cdot \\vec{b} = |\\vec{a}| |\\vec{b}| \\cos \\theta$",
      "type": "text",
      "width": 250,
      "x": -2493,
      "y": 3392
    },
    {
      "height": 60,
      "id": "2be74e23529c62e0",
      "text": "向量与向量相乘",
      "type": "text",
      "width": 270,
      "x": -2924,
      "y": 3206
    },
