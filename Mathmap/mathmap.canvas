    },
    {
      "height": 60,
      "id": "c935aa4e1a1c45c1",
      "text": "[[Mathmap/题型/按章节分类/人教A-必修第一册/第三章 函数的概念与性质/3.1 函数的概念及其表示/习题3.1|习题3.1 函数的概念及其表示]]",
      "type": "text",
      "width": 250,
      "x": -9564,
      "y": -7740
    },
    {
      "color": "2",
      "height": 60,
      "id": "f6733a8d562e4a43",
      "text": "[[Mathmap/知识点/知识点-定义域|定义域]]",
      "type": "text",
      "width": 140,
      "x": -9989,
      "y": -7110
    },
    {
      "height": 60,
      "id": "7839fdcacb9c1f8b",
      "text": " [[Mathmap/知识点/知识点-值域|值域]]",
      "type": "text",
      "width": 120,
      "x": -9989,
      "y": -7022
    },
    {
      "height": 60,
      "id": "cb4f2d30e1b956aa",
      "text": "函数关系式",
      "type": "text",
      "width": 193,
      "x": -10016,
      "y": -7545
    },
    {
      "color": "4",
      "height": 60,
      "id": "85759c2ebb65a152",
      "text": "[[Mathmap/知识点/知识点-带特殊值法|带特殊值法]]",
      "type": "text",
      "width": 197,
      "x": -6372,
      "y": -9545
    },
    {
      "color": "2",
      "height": 60,
      "id": "111115af6203e4f0",
      "text": "\n[[Mathmap/知识点/等式的基本性质|等式基本性质]]",
      "type": "text",
      "width": 170,
      "x": -5806,
      "y": -10557
    },
    {
      "height": 60,
      "id": "7f9b53af83194bb8",
      "text": "$a > b,b > c\\Rightarrow a > c.$",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10617
    },
    {
      "color": "2",
      "height": 60,
      "id": "6318c04f0cfd96b5",
      "text": "[[Mathmap/知识点/知识点-比较两个数的大小|比较两个数的大小]]",
      "type": "text",
      "width": 197,
      "x": -5820,
      "y": -10415
    },
    {
      "height": 60,
      "id": "2d61c705dc19d502",
      "text": "方程",
      "type": "text",
      "width": 115,
      "x": -4769,
      "y": -9865
    },
    {
      "height": 60,
      "id": "28ea7875480537e9",
      "text": "先平方",
      "type": "text",
      "width": 144,
      "x": -6372,
      "y": -9285
    },
    {
      "height": 147,
      "id": "5f133a4f30ca4b79",
      "text": "有没有发现最后2个性质没有讨论$a < b < 0$",
      "type": "text",
      "width": 281,
      "x": -6372,
      "y": -9878
    },
    {
      "color": "4",
      "height": 60,
      "id": "2240ddfa15b13794",
      "text": "做减法",
      "type": "text",
      "width": 144,
      "x": -6372,
      "y": -9445
    },
    {
      "color": "4",
      "height": 60,
      "id": "a7ed2d13f3fa791c",
      "text": "做除法",
      "type": "text",
      "width": 144,
      "x": -6372,
      "y": -9365
    },
    {
      "height": 60,
      "id": "b42e4a097b221f2f",
      "text": "先化简",
      "type": "text",
      "width": 141,
      "x": -6372,
      "y": -9625
    },
    {
      "color": "6",
      "height": 60,
      "id": "9870bd68d953336f",
      "text": "[[Mathmap/知识点/知识点-比大小|比大小]]",
      "type": "text",
      "width": 250,
      "x": -7072,
      "y": -9445
    },
    {
      "height": 60,
      "id": "7d28a4981efb55ad",
      "text": "[[Mathmap/知识点/知识点-二次函数|二次函数]]",
      "type": "text",
      "width": 161,
      "x": -4632,
      "y": -9467
    },
    {
      "height": 60,
      "id": "965b02d2d7718641",
      "text": "[[Mathmap/知识点/知识点-一元二次方程|一元二次方程]]",
      "type": "text",
      "width": 228,
      "x": -5100,
      "y": -9655
    },
    {
      "color": "4",
      "height": 67,
      "id": "64eca4f79e77aaa6",
      "text": "[[Mathmap/知识点/知识点-函数思想-参数分离法|函数思想-参数分离法]]",
      "type": "text",
      "width": 339,
      "x": -4711,
      "y": -8717
    },
    {
      "height": 60,
      "id": "9c2615ed101410a8",
      "text": "[[Mathmap/题型/按章节分类/人教A-必修第一册/第三章 函数的概念与性质/第三章 函数的概念与性质 复习参考题 3|复习参考题3 函数的概念与性质]]",
      "type": "text",
      "width": 250,
      "x": -5987,
      "y": -7846
    },
    {
      "color": "6",
      "height": 94,
      "id": "d276eaff45cbce25",
      "text": "根据元素与集合的关系求参数",
      "type": "text",
      "width": 250,
      "x": -7502,
      "y": -10145
    },
    {
      "color": "6",
      "height": 90,
      "id": "6a83184bcb10b4ee",
      "text": "判断元素与集合的关系",
      "type": "text",
      "width": 250,
      "x": -7722,
      "y": -10369
    },
    {
      "color": "6",
      "height": 90,
      "id": "e0aa4be55bd7d17f",
      "text": "是否可以构成一个集合",
      "type": "text",
      "width": 250,
      "x": -8222,
      "y": -10369
    },
    {
      "color": "6",
      "height": 110,
      "id": "4d4143df1ee9fea1",
      "text": "是否为同一个集合",
      "type": "text",
      "width": 250,
      "x": -7722,
      "y": -10623
    },
    {
      "height": 60,
      "id": "7bbe589eb295b7ec",
      "text": "[[Mathmap/题型/按章节分类/人教A-必修第一册/第一章 集合与常用逻辑用语/第一章 集合与常用逻辑用语 复习参考题 1|复习参考题1 集合与常用逻辑用语]]",
      "type": "text",
      "width": 250,
      "x": -9205,
      "y": -10237
    },
    {
      "height": 60,
      "id": "95ef4a8ec4c79de5",
      "text": "[[Mathmap/知识串联/人教A-必修第一册/第一章 集合与常用逻辑用语/第一章 集合与常用逻辑用语 小结|集合与常用逻辑用语 小结]]",
      "type": "text",
      "width": 250,
      "x": -9205,
      "y": -10353
    },
    {
      "height": 60,
      "id": "44e6690d168dd0b2",
      "text": "如果  $a > b > 0$  ,那么  $a^{n} > b^{n}$  (  $n \\in \\mathbf{N}$  ,  $n \\geq 2$  )",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10107
    },
    {
      "height": 60,
      "id": "bab64b171d860b72",
      "text": "如果  $a > b$  ,那么  $a + c > b + c$",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10507
    },
    {
      "color": "2",
      "height": 60,
      "id": "34bc73ecab09e840",
      "text": "[[Mathmap/知识点/知识点-不等式|不等式]]",
      "type": "text",
      "width": 250,
      "x": -4836,
      "y": -10425
    },
    {
      "height": 60,
      "id": "5f94c1beaa3aeede",
      "text": "如果  $a > b > 0$  ,  $c > d > 0$  ,那么  $a c > b d$",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10187
    },
    {
      "height": 60,
      "id": "2b2bd2c3cac99ece",
      "text": "如果  $a > b$  ,  $c > d$  ,那么  $a + c > b + d$",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10287
    },
    {
      "height": 102,
      "id": "e7538cfe9079afdf",
      "text": "$a > b \\implies \\begin{cases} ac > bc, & c > 0 \\\\ ac < bc, & c < 0 \\end{cases}$",
      "type": "text",
      "width": 372,
      "x": -5460,
      "y": -10415
    },
    {
      "color": "1",
      "height": 605,
      "id": "9e186f0c6b6c6441",
      "text": "[[Mathmap/知识串联/人教A-必修第一册/第二章 一元二次函数、方程和不等式/第二章 一元二次函数、方程和不等式|第二章 一元二次函数、方程和不等式]]",
      "type": "text",
      "width": 50,
      "x": -5960,
      "y": -11200
    }
  ]
}
