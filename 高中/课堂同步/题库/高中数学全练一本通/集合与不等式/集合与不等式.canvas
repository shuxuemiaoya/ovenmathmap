      "text": "[知识导学](%E9%AB%98%E4%B8%AD/%E8%AF%BE%E5%A0%82%E5%90%8C%E6%AD%A5/%E9%A2%98%E5%BA%93/%E9%AB%98%E4%B8%AD%E6%95%B0%E5%AD%A6%E5%85%A8%E7%BB%83%E4%B8%80%E6%9C%AC%E9%80%9A/%E9%9B%86%E5%90%88%E4%B8%8E%E4%B8%8D%E7%AD%89%E5%BC%8F/12_%E7%AC%AC%E4%B8%83%E8%8A%82_%E4%B8%93%E9%A2%98__%E5%88%86%E5%BC%8F_%E7%BB%9D%E5%AF%B9%E5%80%BC_%E9%AB%98%E6%AC%A1%E4%B8%8D%E7%AD%89%E5%BC%8F%E7%9A%84%E8%A7%A3%E6%B3%95/%E7%9F%A5%E8%AF%86%E5%AF%BC%E5%AD%A6/%E7%9F%A5%E8%AF%86%E5%AF%BC%E5%AD%A6.md)",
