      "text": "[（1）权方和不等式最简形式：](%E9%AB%98%E4%B8%AD/%E8%AF%BE%E5%A0%82%E5%90%8C%E6%AD%A5/%E9%A2%98%E5%BA%93/%E9%AB%98%E4%B8%AD%E6%95%B0%E5%AD%A6%E5%85%A8%E7%BB%83%E4%B8%80%E6%9C%AC%E9%80%9A/%E9%9B%86%E5%90%88%E4%B8%8E%E4%B8%8D%E7%AD%89%E5%BC%8F/13_%E7%AC%AC%E5%85%AB%E8%8A%82_%E4%B8%93%E9%A2%98_%E6%9F%AF%E8%A5%BF%E4%B8%8E%E6%9D%83%E6%96%B9%E5%92%8C%E4%B8%8D%E7%AD%89%E5%BC%8F/%E7%9F%A5%E8%AF%86%E5%AF%BC%E5%AD%A6/_1_%E6%9D%83%E6%96%B9%E5%92%8C%E4%B8%8D%E7%AD%89%E5%BC%8F%E6%9C%80%E7%AE%80%E5%BD%A2%E5%BC%8F_/_1_%E6%9D%83%E6%96%B9%E5%92%8C%E4%B8%8D%E7%AD%89%E5%BC%8F%E6%9C%80%E7%AE%80%E5%BD%A2%E5%BC%8F_.md)",
