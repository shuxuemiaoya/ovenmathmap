      "text": "[题型 3: 在给定范围上的有解问题](%E9%AB%98%E4%B8%AD/%E8%AF%BE%E5%A0%82%E5%90%8C%E6%AD%A5/%E9%A2%98%E5%BA%93/%E9%AB%98%E4%B8%AD%E6%95%B0%E5%AD%A6%E5%85%A8%E7%BB%83%E4%B8%80%E6%9C%AC%E9%80%9A/%E9%9B%86%E5%90%88%E4%B8%8E%E4%B8%8D%E7%AD%89%E5%BC%8F/11_%E7%AC%AC%E5%85%AD%E8%8A%82_%E4%B8%93%E9%A2%98_%E4%B8%80%E5%85%83%E4%BA%8C%E6%AC%A1%E4%B8%8D%E7%AD%89%E5%BC%8F%E7%9A%84%E6%81%92%E6%88%90%E7%AB%8B%E4%B8%8E%E6%9C%89%E8%A7%A3%E9%97%AE%E9%A2%98/____%E9%87%8D%E7%82%B9%E9%A2%98%E5%9E%8B%E4%B8%93%E7%BB%83/%E9%A2%98%E5%9E%8B_3__%E5%9C%A8%E7%BB%99%E5%AE%9A%E8%8C%83%E5%9B%B4%E4%B8%8A%E7%9A%84%E6%9C%89%E8%A7%A3%E9%97%AE%E9%A2%98/%E9%A2%98%E5%9E%8B_3__%E5%9C%A8%E7%BB%99%E5%AE%9A%E8%8C%83%E5%9B%B4%E4%B8%8A%E7%9A%84%E6%9C%89%E8%A7%A3%E9%97%AE%E9%A2%98.md)",
